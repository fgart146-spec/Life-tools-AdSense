# =============================================================================
# 생활·경제 실용도구 플랫폼 — 환경변수 예시
# 실제 값은 .env.local (로컬) / Vercel Project Settings (배포)에 넣는다.
# 이 파일에는 절대 실제 키를 넣지 않는다.
# =============================================================================

# --- 사이트 기본 (빌드 타임에 metadata/canonical/sitemap 생성에 사용) --------
# 배포 도메인. 마지막 슬래시 없이 입력.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 사이트 표시명(브랜드 변경 시 여기와 src/config/site.ts만 수정)
NEXT_PUBLIC_SITE_NAME="생활계산소"
# 문의용 이메일 (About/Contact/Privacy에 노출)
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"

# --- Analytics ---------------------------------------------------------------
# GA4 측정 ID. 비어 있으면 스크립트 자체를 로드하지 않는다(성능/비용).
NEXT_PUBLIC_GA_ID=""
# Google Search Console 소유확인 메타태그 값 (선택)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Naver 서치어드바이저 소유확인 메타태그 값 (선택)
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=""

# --- AdSense -----------------------------------------------------------------
# ca-pub-XXXXXXXXXXXXXXXX. 비어 있으면 광고 스크립트/슬롯이 렌더되지 않는다.
NEXT_PUBLIC_ADSENSE_CLIENT=""
# 광고 슬롯 ID (승인 후 발급). 비어 있으면 해당 위치는 렌더되지 않는다.
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_TOP=""
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_MIDDLE=""
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_BOTTOM=""
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=""

# --- Supabase (PHASE 8: 관리자 전용. 공개 페이지 렌더에는 사용하지 않는다) ----
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# 서버 전용 키. NEXT_PUBLIC_ 접두사 금지. 클라이언트 번들에 절대 포함 금지.
SUPABASE_SERVICE_ROLE_KEY=""

# --- 자동화 (PHASE 10) --------------------------------------------------------
# Vercel Cron 호출 인증용 시크릿
CRON_SECRET=""
# Search Console API 서비스 계정 (JSON 문자열 또는 base64 인코딩 값)
GSC_SERVICE_ACCOUNT_JSON=""
# Search Console 속성 URL (예: https://example.com/ 또는 sc-domain:example.com)
GSC_SITE_URL=""
# AI 분석용 (주 1회 cron 배치에서만 호출. 사용자 요청마다 호출하지 않는다)
ANTHROPIC_API_KEY=""
